FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV FROG_HOME=/tmp/frog
ENV FROG_RUNTIME_DIR=/tmp/frog

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY mobile_requirements.txt .
RUN pip install --no-cache-dir -r mobile_requirements.txt

COPY config.py downloader.py mobile_api.py ./

EXPOSE 8000

CMD ["uvicorn", "mobile_api:app", "--host", "0.0.0.0", "--port", "8000"]
